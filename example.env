NP_CORE_ADDR=localhost:7000
NP_CORE_KEY=change-me-core-internal-key-change-me-internal!
NP_HTTP_ADDR=:8003
NP_XMPP_ADDR=:8523
NP_TICKET_KEY=/run/ps3/np-ticket-key.pem
NP_TROPHY_RESOURCE_KEY=/run/ps3/trophy-resource-key.bin
NP_PROVISION_ACCOUNTS=true
NP_SESSION_CLIENT=ps3
# NP_SESSION_OS=
# Required for built-in XMPP TLS; otherwise use an external PS3-compatible terminator.
# NP_XMPP_TLS=1
# NP_TLS_CA_CERT=/run/ps3/ca.crt
# NP_TLS_CA_KEY=/run/ps3/ca.key
# NP_TLS_ADDR=:8443
# REQUIRED: message delivery cursors and PS3 attachments (Postgres). The service refuses to start without it.
NP_DATABASE_URL=postgres://np_community:change-me@postgres/np_community?sslmode=disable
# Matching2 discovery. Unset = the resource says status=maintenance with no agent.
# Set to "hostname:port" to advertise one alive agent-fqdn (id 1) at that host/port.
# NP_MATCHING_AGENT=matching.np.community.playstation.net:3480
# Friend messages go through the neutral chat service (gRPC). Unset = messages answer service-unavailable.
# NP_CHAT_ADDR=openpak-chat:20131
# NP_CHAT_KEY=change-me-chat-internal-key
